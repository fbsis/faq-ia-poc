NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://faq:faq@localhost:5432/faq
CACHE_REDIS_URL=redis://localhost:6379
QUEUE_REDIS_URL=redis://localhost:6380
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=deterministic
SESSION_SECRET=change-this-local-session-secret-at-least-32-characters
SESSION_TTL_SECONDS=28800
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ORGANIZATION_TIME_ZONE=America/Sao_Paulo
FAQ_ACCEPTANCE_THRESHOLD=0.78
FAQ_AMBIGUITY_THRESHOLD=0.70
