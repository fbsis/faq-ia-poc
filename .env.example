NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://faq:faq@localhost:5432/faq
CACHE_REDIS_URL=redis://localhost:6379
QUEUE_REDIS_URL=redis://localhost:6380
QUEUE_PREFIX=faq-local
EMBEDDING_JOB_ATTEMPTS=5
EMBEDDING_BACKOFF_MS=2000
EMBEDDING_BACKOFF_JITTER=0.2
EMBEDDING_WORKER_CONCURRENCY=5
EMBEDDING_GLOBAL_CONCURRENCY=10
EMBEDDING_RATE_LIMIT_MAX=60
EMBEDDING_RATE_LIMIT_DURATION_MS=60000
BULL_BOARD_MUTATIONS_ENABLED=false
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.6-luna
EMBEDDING_PROVIDER=deterministic
CONVERSATION_PROVIDER=openai
SESSION_SECRET=change-this-local-session-secret-at-least-32-characters
SESSION_TTL_SECONDS=28800
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ORGANIZATION_TIME_ZONE=America/Sao_Paulo
FAQ_ACCEPTANCE_THRESHOLD=0.78
FAQ_AMBIGUITY_THRESHOLD=0.70
VITE_API_PROXY_TARGET=http://localhost:3000
