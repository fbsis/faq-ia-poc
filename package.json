{
  "name": "faq-intelligence-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @faq/api --filter @faq/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @faq/contracts build && pnpm -r --if-present typecheck",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --exclude '**/integration/**'",
    "test:integration": "RUN_INTEGRATION=true vitest run '**/integration/**'",
    "test:retrieval": "vitest run --config tests/retrieval/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "db:migrate": "pnpm --filter @faq/api db:migrate",
    "db:seed": "pnpm --filter @faq/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.4",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
